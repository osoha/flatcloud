DATABASE_URL=postgresql://user:password@localhost:5432/flatcloud_rent
SESSION_SECRET=change-me-to-at-least-32-characters
BANK_TOKEN_ENCRYPTION_KEY=use-the-same-long-random-value-for-web-and-cron
INITIAL_ADMIN_NAME=Ondrej Sohaj
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-at-least-12-chars

# Výchozí / prioritní přímý konektor České spořitelny
BANKING_PROVIDER=csas-premium
CSAS_CLIENT_ID=
CSAS_CLIENT_SECRET=
CSAS_WEB_API_KEY=
CSAS_API_BASE_URL=
CSAS_AUTH_URL=
CSAS_TOKEN_URL=
CSAS_CONSENTS_PATH=/consents
CSAS_ACCOUNTS_PATH=/accounts
CSAS_TRANSACTIONS_PATH_TEMPLATE=/accounts/{accountId}/transactions
CSAS_BALANCES_PATH_TEMPLATE=/accounts/{accountId}/balances
CSAS_SCOPE_TEMPLATE=AIS:{consentId} openid offline_access

# Volitelný agregátor pro další banky
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com

# E-mailové pozvánky
RESEND_API_KEY=
INVITE_FROM_EMAIL=FlatCloud Rent <pozvanky@your-domain.cz>

# SMTP pro pozvánky
SMTP_HOST=smtp.fortion.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=FlatCloud
SMTP_FROM_EMAIL=

# Automatické platební zprávy a upomínky používají stejné SMTP.
# Po prvním uložení v Administraci aplikace mají databázové hodnoty přednost.
