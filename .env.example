DATABASE_URL=postgresql://user:password@localhost:5432/flatcloud_rent
SESSION_SECRET=change-me-to-at-least-32-characters
# Stávající produkční název tajného klíče zůstává kvůli kompatibilitě; používá se pro IMAP a SMTP hesla.
BANK_TOKEN_ENCRYPTION_KEY=use-one-long-random-secret-for-web-and-crons
INITIAL_ADMIN_NAME=Ondrej Sohaj
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-at-least-12-chars

# SMTP – lze nastavit také z Administrace aplikace.
SMTP_HOST=smtp.fortion.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=FlatCloud
SMTP_FROM_EMAIL=
