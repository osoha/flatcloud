generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  OWNER_VIEWER
  PROPERTY_MANAGER
}

enum PropertyPermission {
  VIEW
  EDIT
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PaymentStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  PARTIAL
  OVERPAYMENT
  IGNORED
}

enum LeaseStatus {
  ACTIVE
  ENDED
  FUTURE
}

enum InboxPaymentStatus {
  RECEIVED
  UNMATCHED
  IMPORTED
  IGNORED
  ERROR
}

enum RentTiming {
  ADVANCE
  ARREARS
}

enum PropertyOwnershipMode {
  WHOLE_OBJECT
  UNIT_BASED
  SVJ
}

enum MatchRuleAction {
  IGNORE
  MATCH_LEASE
  SUGGEST_LEASE
}

enum OwnerType {
  COMPANY
  PERSON
  SPV
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  GARAGE
  PARKING
  STORAGE
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  RENOVATION
  INACTIVE
}

enum TenantType {
  PERSON
  COMPANY
}

enum MeterType {
  COLD_WATER
  HOT_WATER
  ELECTRICITY_HIGH_TARIFF
  ELECTRICITY_LOW_TARIFF
  GAS
}

enum NotificationType {
  PAYMENT_NOTICE
  FIRST_REMINDER
  SECOND_REMINDER
  MANAGER_ALERT
  ESCALATION
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskCategory {
  COLLECTION
  MAINTENANCE
  LEASE
  COMPLIANCE
  GENERAL
}

enum TaskEntryKind {
  COMMENT
  CALL
  EMAIL
  PROMISE
  STATUS
  SYSTEM
}

enum ComplianceResult {
  OK
  ISSUE
  FOLLOW_UP
}

enum ContactCategory {
  MANAGER
  EMERGENCY
  ELECTRICIAN
  PLUMBER
  HEATING
  ELEVATOR
  FIRE_SAFETY
  INSPECTION
  INSURANCE
  CLEANING
  UTILITY
  OTHER
}

enum ChargeCategory {
  RENT
  WATER
  HEATING
  ELECTRICITY
  SERVICES
  PARKING
  DEPOSIT
  OTHER
  ADJUSTMENT
}

model User {
  id                          String              @id @default(cuid())
  email                       String              @unique
  name                        String
  passwordHash                String
  role                        UserRole            @default(OWNER_VIEWER)
  active                      Boolean             @default(true)
  allProperties               Boolean             @default(false)
  phone                       String?
  title                       String?
  avatarData                  Bytes?
  avatarMimeType              String?
  memberships                 UserProperty[]
  unitMemberships             UserUnit[]
  invitationsSent             UserInvitation[]    @relation("InvitationSender")
  managedProperties           Property[]          @relation("PropertyManager")
  auditLogs                   AuditLog[]
  tasksCreated                Task[]               @relation("TaskCreator")
  tasksAssigned               Task[]               @relation("TaskAssignee")
  taskEntries                 TaskEntry[]
  complianceRecordsCreated    ComplianceRecord[]   @relation("ComplianceRecordCreator")
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
}

model Owner {
  id                      String              @id @default(cuid())
  name                    String
  type                    OwnerType           @default(COMPANY)
  ico                     String?
  email                   String?
  phone                   String?
  address                 String?
  note                    String?
  active                  Boolean             @default(true)
  properties              Property[]
  propertyOwnerships      PropertyOwnership[]
  unitOwnerships          UnitOwnership[]
  bankAccounts            BankAccount[]
  paymentAccounts         OwnerBankAccount[]
  communicationProperties Property[]          @relation("PropertyCommunicationOwner")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

model OwnerBankAccount {
  id             String          @id @default(cuid())
  ownerId        String
  owner          Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label          String?
  accountNumber  String?
  bankCode       String?
  iban           String?
  currency                   String          @default("CZK")
  active                     Boolean         @default(true)
  lastNotificationAt         DateTime?
  unitOwnerships             UnitOwnership[]
  leases         Lease[]
  propertyLinks  PropertyPaymentAccount[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId, active])
}

model Property {
  id                   String                @id @default(cuid())
  name                 String
  address              String
  city                 String
  postalCode           String?
  note                 String?
  technicalData        Json?
  active               Boolean               @default(true)
  ownerId              String
  owner                Owner                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownershipMode        PropertyOwnershipMode @default(WHOLE_OBJECT)
  communicationOwnerId String?
  communicationOwner   Owner?                @relation("PropertyCommunicationOwner", fields: [communicationOwnerId], references: [id], onDelete: SetNull)
  managerId            String?
  manager              User?                 @relation("PropertyManager", fields: [managerId], references: [id], onDelete: SetNull)
  ownerships           PropertyOwnership[]
  units                Unit[]
  bankAccounts         BankAccount[]
  matchingRules        BankMatchingRule[]
  memberships          UserProperty[]
  invitations          UserInvitation[]
  inboxPayments        InboxPayment[]
  paymentAccounts      PropertyPaymentAccount[]
  tasks                Task[]
  contacts             PropertyContact[]
  complianceItems      ComplianceItem[]
  auditLogs            AuditLog[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([ownerId])
  @@index([communicationOwnerId])
  @@index([managerId])
}


model PropertyPaymentAccount {
  id                 String           @id @default(cuid())
  propertyId         String
  property           Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerBankAccountId String
  ownerBankAccount   OwnerBankAccount @relation(fields: [ownerBankAccountId], references: [id], onDelete: Cascade)
  primary                Boolean          @default(false)
  active                 Boolean          @default(true)
  notificationVerifiedAt DateTime?
  lastNotificationAt     DateTime?
  createdAt              DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([propertyId, ownerBankAccountId])
  @@index([ownerBankAccountId, active])
  @@index([propertyId, active])
}

model PropertyOwnership {
  id               String   @id @default(cuid())
  propertyId       String
  ownerId          String
  shareBasisPoints Int      @default(10000)
  note             String?
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([propertyId, ownerId])
  @@index([ownerId])
}

model UserProperty {
  userId     String
  propertyId String
  permission PropertyPermission @default(VIEW)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId, permission])
}

model UserUnit {
  userId     String
  unitId     String
  permission PropertyPermission @default(VIEW)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit       Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId, permission])
}

model UserInvitation {
  id            String             @id @default(cuid())
  email         String
  name          String?
  tokenHash     String             @unique
  propertyId    String
  propertyIds   String[]           @default([])
  unitIds       String[]           @default([])
  allProperties Boolean            @default(false)
  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  permission    PropertyPermission @default(VIEW)
  invitedById   String
  invitedBy     User               @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  status        InvitationStatus   @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([propertyId, status])
  @@index([email, status])
}

model AppSetting {
  id                         String    @id @default("global")
  smtpHost                   String?
  smtpPort                   Int       @default(587)
  smtpSecure                 Boolean   @default(false)
  smtpUser                   String?
  smtpPasswordEncrypted      String?
  smtpFromName               String?
  smtpFromEmail              String?
  smtpReplyTo                String?
  remindersEnabled           Boolean   @default(false)
  reminderSendHour           Int       @default(8)
  paymentNoticeDaysBefore    Int       @default(5)
  firstReminderDaysAfter     Int       @default(3)
  secondReminderDaysAfter    Int       @default(10)
  managerAlertDaysAfter      Int       @default(20)
  escalationDaysAfter        Int       @default(30)
  paymentNoticeSubject       String    @default("Platební údaje k nájmu – {{property}} / {{unit}}")
  paymentNoticeBody          String    @default("Dobrý den,\n\nzasíláme platební údaje k předpisu za období {{period}} se splatností {{dueDate}}.\n\nČástka: {{amount}}\nČíslo účtu / IBAN: {{iban}}\nVariabilní symbol: {{variableSymbol}}\n\nDěkujeme za včasnou úhradu.")
  firstReminderSubject       String    @default("Upozornění na neuhrazený předpis – {{property}} / {{unit}}")
  firstReminderBody          String    @default("Dobrý den,\n\nk dnešnímu dni neevidujeme úplnou úhradu předpisu po splatnosti. Je možné, že platba ještě nebyla spárována.\n\nAktuální dluh: {{outstanding}}\nČíslo účtu / IBAN: {{iban}}\nVariabilní symbol: {{variableSymbol}}\n\nProsíme o kontrolu platby nebo kontaktování správce.")
  secondReminderSubject      String    @default("Druhá upomínka – {{property}} / {{unit}}")
  secondReminderBody         String    @default("Dobrý den,\n\nani po předchozím upozornění neevidujeme úplnou úhradu závazků po splatnosti.\n\nAktuální dluh: {{outstanding}}\nNejstarší splatnost: {{oldestDueDate}}\nČíslo účtu / IBAN: {{iban}}\nVariabilní symbol: {{variableSymbol}}\n\nProsíme o neprodlenou úhradu nebo kontaktování správce.")
  lastReminderCronStartedAt  DateTime?
  lastReminderCronFinishedAt DateTime?
  lastReminderCronSummary    String?
  inboundMailEnabled          Boolean   @default(false)
  inboundMailHost             String?
  inboundMailPort             Int       @default(993)
  inboundMailSecure           Boolean   @default(true)
  inboundMailUser             String?
  inboundMailPasswordEncrypted String?
  inboundMailMailbox          String    @default("INBOX")
  inboundMailLastUid          Int       @default(0)
  inboundMailLastCheckedAt    DateTime?
  inboundMailLastSummary      String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model Unit {
  id           String          @id @default(cuid())
  label        String
  floor        String?
  type         UnitType        @default(APARTMENT)
  status       UnitStatus      @default(VACANT)
  areaM2       Float?
  note         String?
  propertyId   String
  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerships   UnitOwnership[]
  userAccesses UserUnit[]
  leases       Lease[]
  meters       Meter[]
  tasks        Task[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([propertyId, label])
  @@index([propertyId])
}

model UnitOwnership {
  id                 String            @id @default(cuid())
  unitId             String
  ownerId            String
  shareBasisPoints   Int               @default(10000)
  note               String?
  ownerBankAccountId String?
  ownerBankAccount   OwnerBankAccount? @relation(fields: [ownerBankAccountId], references: [id], onDelete: SetNull)
  unit               Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  owner              Owner             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([unitId, ownerId])
  @@index([ownerId])
  @@index([ownerBankAccountId])
}

model Tenant {
  id                    String     @id @default(cuid())
  type                  TenantType @default(PERSON)
  name                  String
  email                 String?
  phone                 String?
  address               String?
  ico                   String?
  permanentAddress      String?
  correspondenceAddress String?
  billingAddress        String?
  billingEmail          String?
  communicationEmail    String?
  note                  String?
  active                Boolean    @default(true)
  payerAccounts         String[]
  leases                Lease[]
  tasks                 Task[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Lease {
  id                    String             @id @default(cuid())
  unitId                String
  tenantId              String
  unit                  Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contractNumber        String?
  startDate             DateTime
  endDate               DateTime?
  dueDay                Int                @default(5)
  variableSymbol        String
  currency              String             @default("CZK")
  rentTiming            RentTiming         @default(ADVANCE)
  rentCents             Int
  servicesCents         Int
  depositCents          Int                @default(0)
  note                  String?
  status                LeaseStatus        @default(ACTIVE)
  paymentItems          LeasePaymentItem[]
  charges               Charge[]
  matchingRules         BankMatchingRule[] @relation("RuleTargetLease")
  suggestedTransactions BankTransaction[]  @relation("SuggestedLease")
  occupants             Occupant[]
  meterReadings         MeterReading[]
  notifications         RentNotification[]
  tasks                 Task[]
  remindersPausedUntil  DateTime?
  reminderPauseReason   String?
  promisedPaymentDate   DateTime?
  promisedAmountCents   Int?
  collectionNote        String?
  ownerBankAccountId    String?
  ownerBankAccount      OwnerBankAccount?  @relation(fields: [ownerBankAccountId], references: [id], onDelete: SetNull)
  tenantBankAccount     String?
  autoChargesEnabled    Boolean            @default(true)
  indexationEnabled     Boolean            @default(false)
  indexationPercentBps  Int?
  nextIndexationAt      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([unitId, variableSymbol])
  @@index([tenantId])
  @@index([variableSymbol])
  @@index([ownerBankAccountId])
}

model Occupant {
  id                    String   @id @default(cuid())
  leaseId               String
  lease                 Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  name                  String
  email                 String?
  phone                 String?
  permanentAddress      String?
  correspondenceAddress String?
  note                  String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([leaseId, active])
}

model Meter {
  id            String         @id @default(cuid())
  unitId        String
  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type          MeterType
  label         String?
  serialNumber  String?
  unitOfMeasure String
  active        Boolean        @default(true)
  readings      MeterReading[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([unitId, type])
}

model MeterReading {
  id        String   @id @default(cuid())
  meterId   String
  meter     Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  leaseId   String?
  lease     Lease?   @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  readAt    DateTime
  value     Float
  note      String?
  createdAt DateTime @default(now())

  @@index([meterId, readAt])
  @@index([leaseId])
}

model LeasePaymentItem {
  id          String         @id @default(cuid())
  leaseId     String
  lease       Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  name        String
  category    ChargeCategory @default(OTHER)
  amountCents Int
  validFrom   DateTime
  validTo     DateTime?
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([leaseId, validFrom])
}

model Charge {
  id            String              @id @default(cuid())
  leaseId       String
  lease         Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  period        String
  dueDate       DateTime
  amountCents   Int
  note          String?
  active        Boolean             @default(true)
  items         ChargeItem[]
  allocations   PaymentAllocation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  notifications RentNotification[]

  @@unique([leaseId, period])
  @@index([leaseId, dueDate])
}

model ChargeItem {
  id          String         @id @default(cuid())
  chargeId    String
  charge      Charge         @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  name        String
  category    ChargeCategory @default(OTHER)
  amountCents Int
  createdAt   DateTime       @default(now())

  @@index([chargeId])
}

model BankAccount {
  id                String            @id @default(cuid())
  propertyId        String
  property          Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId           String?
  owner             Owner?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  provider          String
  bankName          String
  accountName       String?
  iban              String?
  ibanMasked        String
  currency          String            @default("CZK")
  externalAccountId String
  transactions      BankTransaction[]
  matchingRules     BankMatchingRule[]

  @@unique([provider, externalAccountId])
  @@index([propertyId])
  @@index([ownerId])
}

model BankMatchingRule {
  id                       String            @id @default(cuid())
  propertyId               String
  property                 Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bankAccountId            String?
  bankAccount              BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  name                     String
  action                   MatchRuleAction
  priority                 Int               @default(100)
  active                   Boolean           @default(true)
  counterpartyIban         String?
  counterpartyNameContains String?
  variableSymbol           String?
  messageContains          String?
  amountCents              Int?
  targetLeaseId            String?
  targetLease              Lease?            @relation("RuleTargetLease", fields: [targetLeaseId], references: [id], onDelete: Cascade)
  matchedTransactions      BankTransaction[] @relation("MatchedRule")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([propertyId, active, priority])
  @@index([bankAccountId])
  @@index([targetLeaseId])
}

model BankTransaction {
  id               String              @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  externalId       String
  bookedAt         DateTime
  amountCents      Int
  currency         String              @default("CZK")
  counterpartyName String?
  counterpartyIban String?
  variableSymbol   String?
  message          String?
  status           PaymentStatus       @default(UNMATCHED)
  matchedRuleId    String?
  matchedRule      BankMatchingRule?   @relation("MatchedRule", fields: [matchedRuleId], references: [id], onDelete: SetNull)
  suggestedLeaseId String?
  suggestedLease   Lease?              @relation("SuggestedLease", fields: [suggestedLeaseId], references: [id], onDelete: SetNull)
  matchNote        String?
  recipientAccount String?
  source            String              @default("manual")
  allocations      PaymentAllocation[]
  inboxPayment      InboxPayment?
  createdAt        DateTime            @default(now())

  @@unique([bankAccountId, externalId])
  @@index([bankAccountId, bookedAt])
  @@index([matchedRuleId])
  @@index([suggestedLeaseId])
}


model InboxPayment {
  id                  String             @id @default(cuid())
  source              String             @default("email")
  bank                String             @default("UNKNOWN")
  messageId           String?            @unique
  imapUid             Int?
  subject             String?
  sender              String?
  returnPath          String?
  authenticationResults String?
  sourceTrusted       Boolean            @default(false)
  receivedAt          DateTime           @default(now())
  bookedAt            DateTime?
  amountCents         Int?
  currency            String             @default("CZK")
  recipientAccount    String?
  counterpartyName    String?
  counterpartyAccount String?
  variableSymbol      String?
  specificSymbol      String?
  constantSymbol      String?
  message             String?
  rawExcerpt          String?
  status              InboxPaymentStatus @default(RECEIVED)
  parseNote           String?
  propertyId          String?
  property            Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  transactionId       String?             @unique
  transaction         BankTransaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, receivedAt])
  @@index([propertyId, status])
  @@index([imapUid])
}

model PaymentAllocation {
  id            String          @id @default(cuid())
  transactionId String
  chargeId      String
  amountCents   Int
  transaction   BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  charge        Charge          @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([transactionId, chargeId])
  @@index([chargeId])
}

model RentNotification {
  id               String             @id @default(cuid())
  leaseId          String
  lease            Lease              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  chargeId         String?
  charge           Charge?            @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  type             NotificationType
  status           NotificationStatus
  recipient        String
  subject          String
  body             String
  referenceDate    DateTime
  outstandingCents Int                @default(0)
  messageId        String?
  error            String?
  sentAt           DateTime?
  createdAt        DateTime           @default(now())

  @@unique([leaseId, type, referenceDate])
  @@index([leaseId, createdAt])
  @@index([chargeId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    TaskCategory @default(GENERAL)
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(NORMAL)
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  leaseId     String?
  lease       Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt       DateTime?
  closedAt    DateTime?
  dedupeKey   String?      @unique
  entries     TaskEntry[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([propertyId, status, dueAt])
  @@index([assigneeId, status, dueAt])
  @@index([leaseId, category, status])
}

model TaskEntry {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind      TaskEntryKind @default(COMMENT)
  body                  String
  promisedPaymentDate   DateTime?
  promisedAmountCents   Int?
  createdAt              DateTime      @default(now())

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
}

model PropertyContact {
  id        String          @id @default(cuid())
  propertyId String
  property  Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category  ContactCategory @default(OTHER)
  name      String
  company   String?
  phone     String?
  email     String?
  note      String?
  emergency Boolean         @default(false)
  active    Boolean         @default(true)
  sortOrder Int             @default(100)
  complianceItems ComplianceItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([propertyId, active, sortOrder])
}

model ComplianceItem {
  id                String             @id @default(cuid())
  propertyId        String
  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name              String
  category          String
  frequencyMonths   Int?
  lastCompletedAt   DateTime?
  nextDueAt         DateTime
  assignedContactId String?
  assignedContact   PropertyContact?   @relation(fields: [assignedContactId], references: [id], onDelete: SetNull)
  note              String?
  active            Boolean            @default(true)
  records           ComplianceRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([propertyId, active, nextDueAt])
  @@index([assignedContactId])
}

model ComplianceRecord {
  id               String           @id @default(cuid())
  complianceItemId String
  complianceItem   ComplianceItem   @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)
  performedAt      DateTime
  result           ComplianceResult @default(OK)
  note             String?
  documentUrl      String?
  nextDueAt        DateTime?
  performedBy      String?
  createdById      String?
  createdBy        User?            @relation("ComplianceRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())

  @@index([complianceItemId, performedAt])
  @@index([createdById, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([propertyId, createdAt])
}
