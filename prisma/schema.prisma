generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  OWNER_VIEWER
  PROPERTY_MANAGER
}

enum PropertyPermission {
  VIEW
  EDIT
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PaymentStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  PARTIAL
  OVERPAYMENT
  IGNORED
}

enum LeaseStatus {
  ACTIVE
  ENDED
  FUTURE
}

enum LeasePartyRole {
  CONTRACTING_PARTY
  PAYER
  GUARANTOR
  CONTACT
}

enum InboxPaymentStatus {
  RECEIVED
  UNMATCHED
  IMPORTED
  IGNORED
  ERROR
}

enum RentTiming {
  ADVANCE
  ARREARS
}

enum PropertyOwnershipMode {
  WHOLE_OBJECT
  UNIT_BASED
  SVJ
}

enum MatchRuleAction {
  IGNORE
  MATCH_LEASE
  SUGGEST_LEASE
}

enum OwnerType {
  COMPANY
  PERSON
  SPV
}

enum OwnerAffiliation {
  UNCLASSIFIED
  FLATCLOUD_PARENT
  FLATCLOUD_GROUP
  EXTERNAL
}

enum PropertyManagementScope {
  FULL_MANAGEMENT
  LIMITED_MANAGEMENT
  MONITORING_ONLY
}

enum PropertyCostKind {
  OPEX
  CAPEX
}

enum PropertyCostStatus {
  PLANNED
  COMMITTED
  ACTUAL
}

enum PropertyCostCategory {
  REPAIRS
  MAINTENANCE
  UTILITIES
  INSURANCE
  TAX
  MANAGEMENT
  LEGAL
  CONSTRUCTION
  EQUIPMENT
  FINANCING
  OTHER
}

enum LoanRateType {
  FIXED
  FLOATING
}

enum PropertyValuationSource {
  PURCHASE_PRICE
  INTERNAL
  EXTERNAL
}

enum RentForecastPlanStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum RentChangeProposalStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  GARAGE
  PARKING
  STORAGE
  OTHER
}

enum UnitDisposition {
  STUDIO
  ONE_KK
  ONE_PLUS_ONE
  TWO_KK
  TWO_PLUS_ONE
  THREE_KK
  THREE_PLUS_ONE
  FOUR_KK
  FOUR_PLUS_ONE
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  RENOVATION
  INACTIVE
}

enum UnitOperationalStatus {
  STANDARD
  RENOVATION
  INACTIVE
}

enum UnitQualityRating {
  A_EXCELLENT
  B_GOOD
  C_RENOVATE
  D_MAJOR_WORK
}

enum UnitInvestmentUrgency {
  NONE
  MONITOR
  PLAN_12_MONTHS
  IMMEDIATE
}

enum UnitValuationSource {
  INTERNAL_COMPARABLES
  EXTERNAL_APPRAISAL
  OFFER_PRICE
  TRANSACTION
}

enum TenantType {
  PERSON
  COMPANY
}

enum MeterType {
  COLD_WATER
  HOT_WATER
  ELECTRICITY_HIGH_TARIFF
  ELECTRICITY_LOW_TARIFF
  GAS
}

enum NotificationType {
  PAYMENT_NOTICE
  FIRST_REMINDER
  SECOND_REMINDER
  MANAGER_ALERT
  ESCALATION
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskCategory {
  COLLECTION
  MAINTENANCE
  LEASE
  COMPLIANCE
  GENERAL
}

enum TaskEntryKind {
  COMMENT
  CALL
  EMAIL
  PROMISE
  STATUS
  SYSTEM
}

enum ComplianceResult {
  OK
  ISSUE
  FOLLOW_UP
}

enum ContactCategory {
  MANAGER
  EMERGENCY
  ELECTRICIAN
  PLUMBER
  HEATING
  ELEVATOR
  FIRE_SAFETY
  INSPECTION
  INSURANCE
  CLEANING
  UTILITY
  OTHER
}

enum ChargeCategory {
  RENT
  WATER
  HEATING
  ELECTRICITY
  SERVICES
  PARKING
  DEPOSIT
  OTHER
  ADJUSTMENT
}

enum SecurityDepositMovementType {
  OPENING_BALANCE
  RECEIVED
  RETURNED
  OFFSET
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  INTEREST_PAID
  INTEREST_ADJUSTMENT_INCREASE
  INTEREST_ADJUSTMENT_DECREASE
}

enum LeaseCreditType {
  SERVICE_SETTLEMENT
  MANUAL_ADJUSTMENT
  OPENING_BALANCE
}

enum UnitOperationalStatusEventSource {
  SYSTEM_BASELINE
  USER_CHANGE
  MANUAL_BASELINE
}

enum ReportingGroupPermission {
  VIEW
  EDIT
  ADMIN
}

enum QuarterSnapshotSource {
  CALCULATED
  MANUAL_BASELINE
}

enum QuarterlyReportStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum PropertyReportingStatus {
  STABILIZED
  RENOVATION
  DEVELOPMENT
  EXIT
}

enum DocumentCategory {
  CONTRACT
  CONTRACT_ADDENDUM
  HANDOVER_PROTOCOL
  INSPECTION_PROTOCOL
  PHOTO
  TECHNICAL_DOCUMENT
  INVOICE
  OFFER
  ENERGY_CERTIFICATE
  INSURANCE
  LEGAL
  OTHER
}

enum DocumentPhotoStage {
  BEFORE
  AFTER
  GENERAL
}

enum QuarterlyReportMediaRole {
  PRIMARY
  SECONDARY
}

enum ReportDesignTemplateType {
  QUARTERLY_PROPERTY
}

enum ReportDesignTemplateVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ReportDesignPageRole {
  COVER
  OVERVIEW
  TECHNICAL
  VALUATION
  TRENDS
}

enum ReportDesignBackgroundMode {
  GENERATED
  ASSET
}

model User {
  id                                  String                         @id @default(cuid())
  email                               String                         @unique
  name                                String
  passwordHash                        String
  role                                UserRole                       @default(OWNER_VIEWER)
  active                              Boolean                        @default(true)
  allProperties                       Boolean                        @default(false)
  phone                               String?
  title                               String?
  avatarData                          Bytes?
  avatarMimeType                      String?
  memberships                         UserProperty[]
  unitMemberships                     UserUnit[]
  invitationsSent                     UserInvitation[]               @relation("InvitationSender")
  managedProperties                   Property[]                     @relation("PropertyManager")
  auditLogs                           AuditLog[]
  tasksCreated                        Task[]                         @relation("TaskCreator")
  tasksAssigned                       Task[]                         @relation("TaskAssignee")
  taskEntries                         TaskEntry[]
  complianceRecordsCreated            ComplianceRecord[]             @relation("ComplianceRecordCreator")
  securityDepositTermsCreated         SecurityDepositTerm[]          @relation("SecurityDepositTermCreator")
  securityDepositMovementsCreated     SecurityDepositMovement[]      @relation("SecurityDepositMovementCreator")
  leaseCreditsCreated                 LeaseCredit[]                  @relation("LeaseCreditCreator")
  leaseCreditApplicationsCreated      LeaseCreditApplication[]       @relation("LeaseCreditApplicationCreator")
  operationalStatusEventsCreated      UnitOperationalStatusEvent[]
  reportingGroupMemberships           ReportingGroupMember[]
  quarterSnapshotsCreated             QuarterSnapshot[]
  quarterlyReportsCreated             QuarterlyReport[]              @relation("QuarterlyReportCreator")
  quarterlyReportsReviewed            QuarterlyReport[]              @relation("QuarterlyReportReviewer")
  quarterlyReportsPublished           QuarterlyReport[]              @relation("QuarterlyReportPublisher")
  fileAssetsUploaded                  FileAsset[]                    @relation("FileAssetUploader")
  documentsCreated                    Document[]                     @relation("DocumentCreator")
  quarterlyPropertyReportMediaCreated QuarterlyPropertyReportMedia[] @relation("QuarterlyPropertyReportMediaCreator")
  mfRentDatasetReleasesImported       MfRentDatasetRelease[]         @relation("MfRentDatasetImporter")
  mfRentLocationsConfirmed            PropertyMfRentLocation[]       @relation("MfRentLocationConfirmer")
  propertyValuationsCreated           PropertyValuationSnapshot[]    @relation("PropertyValuationCreator")
  rentForecastPlansCreated            RentForecastPlan[]             @relation("RentForecastPlanCreator")
  rentForecastPlansApproved           RentForecastPlan[]             @relation("RentForecastPlanApprover")
  rentChangeProposalsCreated           RentChangeProposal[]           @relation("RentChangeProposalCreator")
  rentChangeProposalsConfirmed         RentChangeProposal[]           @relation("RentChangeProposalConfirmer")
  serviceSettlementProtocolsIssued     ServiceSettlementProtocol[]    @relation("ServiceSettlementProtocolIssuer")
  unitAssetAssessmentsCreated           UnitAssetAssessment[]          @relation("UnitAssetAssessmentCreator")
  unitValuationsCreated                  UnitValuationSnapshot[]        @relation("UnitValuationCreator")
  createdAt                           DateTime                       @default(now())
  updatedAt                           DateTime                       @updatedAt
}

model Owner {
  id                      String              @id @default(cuid())
  name                    String
  type                    OwnerType           @default(COMPANY)
  affiliation             OwnerAffiliation    @default(UNCLASSIFIED)
  ico                     String?
  email                   String?
  phone                   String?
  address                 String?
  note                    String?
  active                  Boolean             @default(true)
  properties              Property[]
  propertyOwnerships      PropertyOwnership[]
  unitOwnerships          UnitOwnership[]
  bankAccounts            BankAccount[]
  paymentAccounts         OwnerBankAccount[]
  communicationProperties Property[]          @relation("PropertyCommunicationOwner")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([affiliation])
}

model OwnerBankAccount {
  id                     String                   @id @default(cuid())
  ownerId                String
  owner                  Owner                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label                  String?
  accountNumber          String?
  bankCode               String?
  iban                   String?
  currency               String                   @default("CZK")
  active                 Boolean                  @default(true)
  lastNotificationAt     DateTime?
  notificationVerifiedAt DateTime?
  unitOwnerships         UnitOwnership[]
  leases                 Lease[]
  propertyLinks          PropertyPaymentAccount[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([ownerId, active])
}

model Property {
  id                                String                      @id @default(cuid())
  propertyCode                      String                      @unique @default(dbgenerated())
  name                              String
  googleDriveFolderId               String?                     @unique
  address                           String
  city                              String
  postalCode                        String?
  note                              String?
  technicalData                     Json?
  active                            Boolean                     @default(true)
  ownerId                           String
  owner                             Owner                       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownershipMode                     PropertyOwnershipMode       @default(WHOLE_OBJECT)
  communicationOwnerId              String?
  communicationOwner                Owner?                      @relation("PropertyCommunicationOwner", fields: [communicationOwnerId], references: [id], onDelete: SetNull)
  managerId                         String?
  manager                           User?                       @relation("PropertyManager", fields: [managerId], references: [id], onDelete: SetNull)
  managementScope                   PropertyManagementScope     @default(FULL_MANAGEMENT)
  flatcloudConsolidationBasisPoints Int?
  ownerships                        PropertyOwnership[]
  units                             Unit[]
  bankAccounts                      BankAccount[]
  matchingRules                     BankMatchingRule[]
  memberships                       UserProperty[]
  invitations                       UserInvitation[]
  inboxPayments                     InboxPayment[]
  paymentAccounts                   PropertyPaymentAccount[]
  tasks                             Task[]
  contacts                          PropertyContact[]
  complianceItems                   ComplianceItem[]
  costs                             PropertyCost[]
  budgets                           PropertyBudgetLine[]
  loans                             PropertyLoan[]
  valuations                        PropertyValuationSnapshot[]
  rentForecastPlans                 RentForecastPlanProperty[]
  auditLogs                         AuditLog[]
  reportingGroups                   ReportingGroupProperty[]
  quarterSnapshots                  QuarterSnapshot[]
  quarterlyPropertyReports          QuarterlyPropertyReport[]
  documents                         Document[]
  mfRentLocation                    PropertyMfRentLocation?
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt

  @@index([ownerId])
  @@index([communicationOwnerId])
  @@index([managerId])
  @@index([managementScope])
  @@index([flatcloudConsolidationBasisPoints])
}

model PropertyCost {
  id             String                   @id @default(cuid())
  propertyId     String
  property       Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?                    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  kind           PropertyCostKind
  status         PropertyCostStatus       @default(PLANNED)
  category       PropertyCostCategory     @default(OTHER)
  title          String
  amountCents    Int
  effectiveAt    DateTime
  vendor         String?
  documentNumber String?
  note           String?
  documents      Document[]
  allocations    PropertyCostAllocation[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([propertyId, effectiveAt])
  @@index([propertyId, kind, status])
  @@index([unitId])
}

model PropertyCostAllocation {
  id               String       @id @default(cuid())
  propertyCostId   String
  propertyCost     PropertyCost @relation(fields: [propertyCostId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  shareBasisPoints Int
  amountCents      Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([propertyCostId, unitId])
  @@index([unitId])
}

model PropertyBudgetLine {
  id          String               @id @default(cuid())
  propertyId  String
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  year        Int
  kind        PropertyCostKind
  category    PropertyCostCategory @default(OTHER)
  title       String
  amountCents Int
  note        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([propertyId, year])
  @@index([propertyId, year, kind, category])
}

model PropertyLoan {
  id                        String                 @id @default(cuid())
  propertyId                String
  property                  Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lender                    String
  label                     String
  principalCents            Int
  outstandingPrincipalCents Int
  annualInterestRateBps     Int
  rateType                  LoanRateType           @default(FIXED)
  fixedUntil                DateTime?
  maturityDate              DateTime?
  monthlyDebtServiceCents   Int?
  note                      String?
  active                    Boolean                @default(true)
  snapshots                 PropertyLoanSnapshot[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([propertyId, active])
  @@index([fixedUntil])
  @@index([maturityDate])
}

model PropertyLoanSnapshot {
  id                        String       @id @default(cuid())
  loanId                    String
  loan                      PropertyLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  asOfDate                  DateTime
  outstandingPrincipalCents Int
  annualInterestRateBps     Int
  monthlyDebtServiceCents   Int?
  note                      String?
  createdAt                 DateTime     @default(now())

  @@index([loanId, asOfDate])
}

model PropertyValuationSnapshot {
  id               String                  @id @default(cuid())
  propertyId       String
  property         Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  asOfDate         DateTime
  marketValueCents BigInt
  source           PropertyValuationSource
  note             String?
  createdById      String
  createdBy        User                    @relation("PropertyValuationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                @default(now())

  @@index([propertyId, asOfDate])
}

model RentForecastPlan {
  id                  String                     @id @default(cuid())
  seriesId            String
  revision            Int                        @default(1)
  name                String
  status              RentForecastPlanStatus     @default(DRAFT)
  asOfDate            DateTime
  horizonMonths       Int
  annualGrowthBps     Int
  vacancyBps          Int
  collectionBps       Int
  marketGapCaptureBps Int
  inputSnapshot       Json
  note                String?
  createdById         String
  createdBy           User                       @relation("RentForecastPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById        String?
  approvedBy          User?                      @relation("RentForecastPlanApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt          DateTime?
  properties          RentForecastPlanProperty[]
  rentChangeProposals RentChangeProposal[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([seriesId, revision])
  @@index([status, updatedAt])
  @@index([createdById, updatedAt])
}

model RentForecastPlanProperty {
  planId     String
  propertyId String
  plan       RentForecastPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@id([planId, propertyId])
  @@index([propertyId])
}

model RentChangeProposal {
  id                    String                   @id @default(cuid())
  forecastPlanId        String
  forecastPlan          RentForecastPlan         @relation(fields: [forecastPlanId], references: [id], onDelete: Restrict)
  leaseId               String
  lease                 Lease                    @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  status                RentChangeProposalStatus @default(DRAFT)
  previousRentCents     Int
  proposedRentCents     Int
  effectiveFrom         DateTime
  legalBasis            String
  note                  String?
  createdById           String
  createdBy             User                     @relation("RentChangeProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById         String?
  confirmedBy           User?                    @relation("RentChangeProposalConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([forecastPlanId, leaseId])
  @@index([leaseId, status, effectiveFrom])
  @@index([status, effectiveFrom])
}

model PropertyPaymentAccount {
  id                     String           @id @default(cuid())
  propertyId             String
  property               Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerBankAccountId     String
  ownerBankAccount       OwnerBankAccount @relation(fields: [ownerBankAccountId], references: [id], onDelete: Cascade)
  primary                Boolean          @default(false)
  active                 Boolean          @default(true)
  notificationVerifiedAt DateTime?
  lastNotificationAt     DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([propertyId, ownerBankAccountId])
  @@index([ownerBankAccountId, active])
  @@index([propertyId, active])
}

model PropertyOwnership {
  id               String   @id @default(cuid())
  propertyId       String
  ownerId          String
  shareBasisPoints Int      @default(10000)
  note             String?
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([propertyId, ownerId])
  @@index([ownerId])
}

model UserProperty {
  userId     String
  propertyId String
  permission PropertyPermission @default(VIEW)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId, permission])
}

model UserUnit {
  userId     String
  unitId     String
  permission PropertyPermission @default(VIEW)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit       Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId, permission])
}

model UserInvitation {
  id            String             @id @default(cuid())
  email         String
  name          String?
  tokenHash     String             @unique
  propertyId    String
  propertyIds   String[]           @default([])
  unitIds       String[]           @default([])
  allProperties Boolean            @default(false)
  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  permission    PropertyPermission @default(VIEW)
  role          UserRole           @default(OWNER_VIEWER)
  invitedById   String
  invitedBy     User               @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  status        InvitationStatus   @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([propertyId, status])
  @@index([email, status])
}

model AppSetting {
  id                                 String    @id @default("global")
  smtpHost                           String?
  smtpPort                           Int       @default(587)
  smtpSecure                         Boolean   @default(false)
  smtpUser                           String?
  smtpPasswordEncrypted              String?
  smtpFromName                       String?
  smtpFromEmail                      String?
  smtpReplyTo                        String?
  remindersEnabled                   Boolean   @default(false)
  reminderSendHour                   Int       @default(8)
  paymentNoticeDaysBefore            Int       @default(5)
  firstReminderDaysAfter             Int       @default(3)
  secondReminderDaysAfter            Int       @default(10)
  managerAlertDaysAfter              Int       @default(20)
  escalationDaysAfter                Int       @default(30)
  paymentNoticeSubject               String    @default("Platební údaje k nájmu – {{property}} / {{unit}}")
  paymentNoticeBody                  String    @default("Dobrý den,\n\nzasíláme platební údaje k předpisu za období {{period}} se splatností {{dueDate}}.\n\nČástka: {{amount}}\nČíslo účtu / IBAN: {{iban}}\nVariabilní symbol: {{variableSymbol}}\n\nDěkujeme za včasnou úhradu.")
  firstReminderSubject               String    @default("Upozornění na neuhrazený předpis – {{property}} / {{unit}}")
  firstReminderBody                  String    @default("Dobrý den,\n\nk dnešnímu dni neevidujeme úplnou úhradu předpisu po splatnosti. Je možné, že platba ještě nebyla spárována.\n\nAktuální dluh: {{outstanding}}\nČíslo účtu / IBAN: {{iban}}\nVariabilní symbol: {{variableSymbol}}\n\nProsíme o kontrolu platby nebo kontaktování správce.")
  secondReminderSubject              String    @default("Druhá upomínka – {{property}} / {{unit}}")
  secondReminderBody                 String    @default("Dobrý den,\n\nani po předchozím upozornění neevidujeme úplnou úhradu závazků po splatnosti.\n\nAktuální dluh: {{outstanding}}\nNejstarší splatnost: {{oldestDueDate}}\nČíslo účtu / IBAN: {{iban}}\nVariabilní symbol: {{variableSymbol}}\n\nProsíme o neprodlenou úhradu nebo kontaktování správce.")
  lastReminderCronStartedAt          DateTime?
  lastReminderCronFinishedAt         DateTime?
  lastReminderCronSummary            String?
  inboundMailEnabled                 Boolean   @default(false)
  inboundMailHost                    String?
  inboundMailPort                    Int       @default(993)
  inboundMailSecure                  Boolean   @default(true)
  inboundMailUser                    String?
  inboundMailPasswordEncrypted       String?
  inboundMailMailbox                 String    @default("INBOX")
  inboundMailLastUid                 Int       @default(0)
  inboundMailUidValidity             String?
  inboundMailLastCheckedAt           DateTime?
  inboundMailLastSummary             String?
  inboundMailResolvedRetentionDays   Int       @default(100)
  inboundMailUnresolvedRetentionDays Int       @default(100)
  inboundMailLastCleanupAt           DateTime?
  inboundMailLastCleanupSuccessAt    DateTime?
  inboundMailLastCleanupPurged       Int       @default(0)
  inboundMailLastCleanupSummary      String?
  mfRentLastCheckedAt                DateTime?
  mfRentLastSuccessAt                DateTime?
  mfRentLastSummary                  String?
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt
}

model MfRentDatasetRelease {
  id                String                    @id @default(cuid())
  sourceUrl         String
  sourceSha256      String                    @unique
  sourceFileName    String
  publishedOn       DateTime
  marketYear        Int
  marketQuarter     Int
  parserVersion     String
  schemaFingerprint String
  importedAt        DateTime                  @default(now())
  importedById      String?
  importedBy        User?                     @relation("MfRentDatasetImporter", fields: [importedById], references: [id], onDelete: SetNull)
  territories       MfRentTerritorySnapshot[]

  @@index([marketYear, marketQuarter])
  @@index([publishedOn])
}

model MfRentTerritorySnapshot {
  id               String               @id @default(cuid())
  releaseId        String
  release          MfRentDatasetRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  territoryCode    String
  territoryName    String
  municipalityName String?
  districtName     String?
  regionName       String?
  data             Json

  @@unique([releaseId, territoryCode])
  @@index([territoryCode])
  @@index([releaseId])
  @@index([municipalityName])
}

model PropertyMfRentLocation {
  propertyId       String   @id
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  territoryCode    String
  territoryName    String
  municipalityName String?
  confirmedById    String
  confirmedBy      User     @relation("MfRentLocationConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([territoryCode])
}

model Unit {
  id                      String                       @id @default(cuid())
  unitCode                String                       @default(dbgenerated())
  label                   String
  floor                   String?
