  type      ReportDesignTemplateType
  active    Boolean                       @default(true)
  versions  ReportDesignTemplateVersion[]
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt
}

model ReportDesignTemplateVersion {
  id               String                            @id @default(cuid())
  templateId       String
  template         ReportDesignTemplate              @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version          Int
  status           ReportDesignTemplateVersionStatus @default(DRAFT)
  config           Json
  pages            ReportDesignTemplatePage[]
  quarterlyReports QuarterlyReport[]
  createdAt        DateTime                          @default(now())
  activatedAt      DateTime?

  @@unique([templateId, version])
  @@index([templateId, status])
}

model ReportDesignTemplatePage {
  id                String                      @id @default(cuid())
  templateVersionId String
  templateVersion   ReportDesignTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  role              ReportDesignPageRole
  backgroundMode    ReportDesignBackgroundMode  @default(GENERATED)
  backgroundAssetId String?
  backgroundAsset   FileAsset?                  @relation("ReportDesignTemplateBackground", fields: [backgroundAssetId], references: [id], onDelete: Restrict)
  config            Json?

  @@unique([templateVersionId, role])
  @@index([backgroundAssetId])
}

model QuarterlyPropertyReport {
  id                      String                         @id @default(cuid())
  quarterlyReportId       String
  quarterlyReport         QuarterlyReport                @relation(fields: [quarterlyReportId], references: [id], onDelete: Cascade)
  propertyId              String
  property                Property                       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  propertyNameSnapshot    String
  propertyAddressSnapshot String
  snapshotId              String
  snapshot                QuarterSnapshot                @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  propertyStatus          PropertyReportingStatus?
  managementCommentary    String?
  additionalCommentary    String?
  technicalSections       Json?
  valuationRows           Json?
  media                   QuarterlyPropertyReportMedia[]
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  @@unique([quarterlyReportId, propertyId])
  @@index([snapshotId])
}

model FileAsset {
  id                           String                         @id @default(cuid())
  storageKey                   String                         @unique
  previewStorageKey            String?
  thumbnailStorageKey          String?
  originalName                 String
  mimeType                     String
  sizeBytes                    Int
  sha256                       String
  uploadedById                 String
  uploadedBy                   User                           @relation("FileAssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  documents                    Document[]
  publishedReports             QuarterlyReport[]              @relation("QuarterlyReportPublishedAsset")
  quarterlyPropertyReportMedia QuarterlyPropertyReportMedia[]
  reportDesignTemplatePages    ReportDesignTemplatePage[]     @relation("ReportDesignTemplateBackground")
  createdAt                    DateTime                       @default(now())
  deletedAt                    DateTime?

  @@index([sha256])
}

model Document {
  id                           String                         @id @default(cuid())
  propertyId                   String
  property                     Property                       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  fileAssetId                  String
  fileAsset                    FileAsset                      @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  category                     DocumentCategory
  photoStage                   DocumentPhotoStage?
  title                        String
  description                  String?
  documentDate                 DateTime?
  unitId                       String?
  unit                         Unit?                          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  leaseId                      String?
  lease                        Lease?                         @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  taskId                       String?
  task                         Task?                          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskEntryId                  String?
  taskEntry                    TaskEntry?                     @relation(fields: [taskEntryId], references: [id], onDelete: SetNull)
  complianceRecordId           String?
  complianceRecord             ComplianceRecord?              @relation(fields: [complianceRecordId], references: [id], onDelete: SetNull)
  propertyCostId               String?
  propertyCost                 PropertyCost?                  @relation(fields: [propertyCostId], references: [id], onDelete: SetNull)
  createdById                  String
  createdBy                    User                           @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  quarterlyPropertyReportMedia QuarterlyPropertyReportMedia[]
  createdAt                    DateTime                       @default(now())
  deletedAt                    DateTime?

  @@index([propertyId, deletedAt])
  @@index([fileAssetId])
  @@index([unitId])
  @@index([leaseId])
  @@index([taskId])
  @@index([taskEntryId])
  @@index([complianceRecordId])
  @@index([propertyCostId])
}

model QuarterlyPropertyReportMedia {
  id                        String                   @id @default(cuid())
  quarterlyPropertyReportId String
  quarterlyPropertyReport   QuarterlyPropertyReport  @relation(fields: [quarterlyPropertyReportId], references: [id], onDelete: Cascade)
  role                      QuarterlyReportMediaRole
  sortOrder                 Int                      @default(0)
  fileAssetId               String
  fileAsset                 FileAsset                @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  sourceDocumentId          String?
  sourceDocument            Document?                @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  caption                   String?
  createdById               String
  createdBy                 User                     @relation("QuarterlyPropertyReportMediaCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt                 DateTime                 @default(now())

  @@index([quarterlyPropertyReportId, role, sortOrder])
  @@index([fileAssetId])
  @@index([sourceDocumentId])
  @@index([createdById])
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([propertyId, createdAt])
}
